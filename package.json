{
  "name": "kiln",
  "private": true,
  "type": "module",
  "description": "kiln runs a Slack agent on eve that ideates with you and hands repo work to a pool of coding-CLI workers through Vercel Board.",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "eve dev",
    "build": "eve build",
    "deploy": "node scripts/deploy.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "eval": "KILN_CONFIG=\"$(cat evals/deployment.json)\" eve eval",
    "workers:status": "node scripts/boat-workers.ts status",
    "workers:logs": "node scripts/boat-workers.ts logs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@vercel/blob": "2.9.0",
    "@vercel/board": "0.54.0",
    "@vercel/connect": "^2.9.5",
    "ai": "^7.0.179",
    "eve": "1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vercel": "^66.6.0",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
