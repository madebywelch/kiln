{
  "name": "kiln",
  "private": true,
  "type": "module",
  "description": "kiln runs a Slack agent on eve that ideates with you and hands repo work to a pool of coding-CLI workers through Vercel Board.",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "eve dev",
    "build": "eve build",
    "deploy": "node scripts/deploy.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "eval": "EVE_MEMORY_BLOB_STORE_ID= AI_GATEWAY_API_KEY= VERCEL_OIDC_TOKEN= KILN_CONFIG=\"$(cat evals/deployment.json)\" eve eval",
    "workers:status": "node scripts/boat-workers.ts status",
    "workers:logs": "node scripts/boat-workers.ts logs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@vercel/blob": "2.9.0",
    "@vercel/board": "0.56.1",
    "@vercel/connect": "^2.9.6",
    "ai": "^7.0.179",
    "eve": "1.5.0",
    "libsodium-wrappers": "0.7.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/libsodium-wrappers": "0.7.14",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vercel": "^67.0.0",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
