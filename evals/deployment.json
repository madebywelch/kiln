{
  "repos": {
    "web": {
      "github": "acme/web",
      "description": "The marketing site and the customer dashboard.",
      "mcp": ["linear"]
    },
    "api": {
      "github": "acme/api",
      "description": "The backend API and its workers."
    },
    "app": {
      "github": "acme/app",
      "description": "The mobile app."
    },
    "app-api": {
      "github": "acme/app-api",
      "description": "The mobile app's backend API."
    }
  },
  "mcpServers": {
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "headers": {
        "Authorization": "Bearer ${LINEAR_API_KEY}"
      }
    }
  },
  "projects": {
    "mobile": {
      "description": "The mobile app and its backend.",
      "repos": ["app", "app-api"]
    }
  }
}
