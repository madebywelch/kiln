# Settings for the worker pool (scripts/boat-workers.ts). the agent's own settings
# live in its Vercel project's environment; see README.md.

# boat.dev, where the workers run: boat api-key create kiln --preset full-sandbox
BOAT_API_KEY=

# Vercel Board. A Vercel access token (vercel.com/account/tokens) for your
# account, and the team that owns the agent's project.
BOARD_TOKEN=
VERCEL_ORG_ID=
# The agent's actor on the board, whose jobs the workers take:
# vercel:project:<the agent's project id>:production
KILN_BOARD_FROM=

# A fine-grained GitHub token with Contents and Pull requests read/write on the
# repos in lib/config.ts. Workers clone, push job branches, and open draft PRs.
GH_TOKEN=
# Optional. A read-only token for the coding CLI itself, to read CI runs and
# issues with gh. The CLI never sees GH_TOKEN.
HARNESS_GH_TOKEN=

# One long-lived token per Claude subscription: run `claude setup-token` while
# signed in to each account. A worker whose token is unset is not started.
CLAUDE_TOKEN_1=
CLAUDE_TOKEN_2=
CLAUDE_TOKEN_3=

# The opencode-1 worker: an AI Gateway API key (Vercel dashboard, AI Gateway, API keys).
AI_GATEWAY_API_KEY=

# Optional. Commits are authored as "<agent name> (<profile>)" unless both are set.
KILN_GIT_NAME=
KILN_GIT_EMAIL=

# Optional. Minutes before a job's harness is stopped. Default 180.
JOB_TIMEOUT_MINUTES=
