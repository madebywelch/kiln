# Local settings for the operator scripts (pnpm workers:status, pnpm workers:logs).
# The agent and its job machines take everything else from the Vercel project's
# environment; see README.md and docs/workers.md.

# boat.dev API key: sandbox.create, sandbox.read, sandbox.delete-own,
# environment.read, environment.write, exec. The same key as on Vercel.
BOAT_API_KEY=
