# Bearer token for POST /inbox/{user}. At least 32 characters: openssl rand -hex 32
KILN_TOKEN=

# Any OpenAI-compatible chat completions endpoint with tool calling.
KILN_MODEL_URL=https://openrouter.ai/api/v1
KILN_MODEL_KEY=
KILN_MODEL=
# Optional JSON object of extra request fields, e.g. {"reasoning":{"effort":"low"}}
KILN_MODEL_PARAMS=

# Slack, over Socket Mode. See docs/slack.md. Leave both empty to run without it.
KILN_SLACK_BOT_TOKEN=
KILN_SLACK_APP_TOKEN=
# Optional. Unset: everyone in the workspace shares one agent. To restrict or
# split it, map member ids to kiln users: U0123ABCD:robert or U0123ABCD:robert,*:team
KILN_SLACK_USERS=

# The channel of last resort: outbox entries are POSTed here as JSON. Empty: JSON lines on stdout.
KILN_OUTBOX_URL=
